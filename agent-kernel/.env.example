# Agent Kernel 环境配置

# 存储配置
STORAGE_TYPE=file              # 可选: file, sqlite
DATA_PATH=./data               # 文件存储路径
DATABASE_PATH=./data/runtime.db  # SQLite数据库路径

# Python Kernel配置
PYTHON_KERNEL_URL=http://localhost:8000
PYTHON_KERNEL_PORT=8000

# Gateway配置
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0

# LLM配置
OPENAI_API_KEY=your_api_key_here
# 或其他模型提供商
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# 日志级别
LOG_LEVEL=INFO

# OpenTelemetry（可观测性）
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agent-kernel
