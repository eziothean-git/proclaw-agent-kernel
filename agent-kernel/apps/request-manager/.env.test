# 测试环境配置 - 使用 /tmp 目录
STORAGE_BASE_PATH=/tmp/gateway/request-manager
INBOX_PATH=/tmp/gateway/request-manager/inbox
AUDIT_PATH=/tmp/gateway/request-manager/audit
STATE_PATH=/tmp/gateway/request-manager/state

# gRPC 配置
REQUEST_MANAGER_GRPC_PORT=50052
PRIME_PERSONALITY_GRPC_URL=localhost:50051

# 并发
MAX_CONCURRENT_REQUESTS=5
MAX_QUEUE_SIZE=1000

# 超时
TIMEOUT_P0_MS=30000
TIMEOUT_P1_MS=120000
TIMEOUT_P2_MS=60000
TIMEOUT_P3_MS=120000
TIMEOUT_P4_MS=300000

# 重试
MAX_RETRIES=3
RETRY_DELAY_BASE_MS=1000
RETRY_DELAY_MAX_MS=30000
BACKOFF_MULTIPLIER=2

# 调度
SCHEDULER_INTERVAL_MS=100