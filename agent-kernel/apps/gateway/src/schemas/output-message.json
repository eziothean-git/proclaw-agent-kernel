{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent.kernel/schemas/output-message.json",
  "title": "OutputMessage",
  "description": "Kernel 输出的内部中间表示（Prime Personality处理后的结果）",
  "type": "object",
  "required": ["header", "status", "body"],
  "additionalProperties": true,
  "properties": {
    "header": {
      "type": "object",
      "required": ["request_id", "session_id", "timestamp"],
      "additionalProperties": true,
      "properties": {
        "request_id": {
          "type": "string",
          "description": "关联的输入请求ID"
        },
        "session_id": {
          "type": "string",
          "description": "处理会话ID"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "响应生成时间"
        },
        "processing_time_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "处理耗时（毫秒）"
        },
        "model_version": {
          "type": "string",
          "description": "使用的模型版本"
        },
        "compiler_version": {
          "type": "string",
          "description": "Context Compiler 版本"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["completed", "failed", "partial"],
      "description": "处理状态"
    },
    "body": {
      "type": "string",
      "description": "回复正文"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "attachments": {
          "type": "array",
          "description": "生成的附件（图片、文件等）",
          "items": {
            "type": "object",
            "required": ["local_path", "mime_type"],
            "properties": {
              "local_path": {
                "type": "string",
                "description": "文件系统路径"
              },
              "mime_type": {
                "type": "string",
                "description": "MIME类型"
              },
              "description": {
                "type": "string",
                "description": "附件描述"
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "description": "执行的Action记录",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "Action类型"
              },
              "skill": {
                "type": "string",
                "description": "使用的Skill"
              },
              "tool": {
                "type": "string",
                "description": "使用的Tool"
              },
              "status": {
                "type": "string",
                "enum": ["success", "failed", "pending"]
              },
              "duration_ms": {
                "type": "integer",
                "description": "执行耗时"
              }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "description": "失败时详细信息",
      "additionalProperties": true,
      "properties": {
        "category": {
          "type": "string",
          "enum": ["system_error", "timeout", "invalid_request", "skill_failure", "unknown"],
          "description": "错误分类"
        },
        "code": {
          "type": "string",
          "description": "错误代码"
        },
        "message": {
          "type": "string",
          "description": "可读错误信息"
        },
        "stack_trace": {
          "type": "string",
          "description": "堆栈跟踪（敏感环境可选）"
        },
        "recoverable": {
          "type": "boolean",
          "description": "是否可重试"
        },
        "audit_log_ref": {
          "type": "string",
          "description": "指向详细审计日志的路径"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "description": "结构化中间产物（供后续使用）",
      "additionalProperties": true
    }
  }
}
